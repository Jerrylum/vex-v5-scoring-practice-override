{
	"name": "vex-v5-scoring-practice-override",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "bun run --filter @vex-v5-override/web dev",
		"dev:worker": "bun run --filter @vex-v5-override/worker dev",
		"dev:all": "bun run --filter @vex-v5-override/web dev --host 0.0.0.0 & bun run --filter @vex-v5-override/worker dev --ip 0.0.0.0",
		"build": "bun run --filter @vex-v5-override/web build",
		"deploy": "bun run build && bun run --filter @vex-v5-override/worker deploy",
		"check": "bun run --filter '*' check",
		"test": "bun run --filter '*' test",
		"lint": "bun run --filter '*' lint",
		"format": "prettier --write \"apps/web\" \"apps/worker\" \"packages/protocol\" --ignore-path .prettierignore"
	}
}
